											"top": 197,
											"width": 420,
											"height": 30
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTTRANSF000401",
											"_parent": {
												"$ref": "TKTTRANSF000005"
											},
											"text": "(msg 1) Le bouton n'est affiché que pour un ticket « en attente » (ticket-list-item.jsx). Le backend revérifie de toute façon.",
											"fillColor": "#FFF6CC",
											"left": 1925,
											"top": 235,
											"width": 420,
											"height": 62
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTTRANSF000402",
											"_parent": {
												"$ref": "TKTTRANSF000005"
											},
											"text": "[SEC n°16] (msg 4) Limite dédiée : 20 créations de QR par minute.  [SEC n°2, 4] Jeton Firebase vérifié, compte Tiketly obligatoire (sinon 401 / 403).",
											"fillColor": "#FFF6CC",
											"left": 1925,
											"top": 309,
											"width": 420,
											"height": 62
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTTRANSF000403",
											"_parent": {
												"$ref": "TKTTRANSF000005"
											},
											"text": "[SEC n°17] (msg 7) Paramètre validé par Zod : un uid mal formé est refusé avant toute requête SQL.",
											"fillColor": "#FFF6CC",
											"left": 1925,
											"top": 557,
											"width": 420,
											"height": 46
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTTRANSF000404",
											"_parent": {
												"$ref": "TKTTRANSF000005"
											},
											"text": "[SEC n°15] (msg 9) Transaction + verrou sur la ligne du ticket : deux créations simultanées sont traitées l'une après l'autre.",
											"fillColor": "#FFF6CC",
											"left": 1925,
											"top": 689,
											"width": 420,
											"height": 62
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTTRANSF000405",
											"_parent": {
												"$ref": "TKTTRANSF000005"
											},
											"text": "[SEC n°5, 14] (msg 9) Le ticket doit appartenir à l'utilisateur du jeton Firebase et être encore en attente.",
											"fillColor": "#FFF6CC",
											"left": 1925,
											"top": 1011,
											"width": 420,
											"height": 46
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTTRANSF000406",
											"_parent": {
												"$ref": "TKTTRANSF000005"
											},
											"text": "[SEC n°13] (msg 15) Un nouveau QR invalide le précédent : il n'y a jamais deux transferts en attente pour un ticket (index unique partiel).",
											"fillColor": "#FFF6CC",
											"left": 1925,
											"top": 1065,
											"width": 420,
											"height": 62
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTTRANSF000407",
											"_parent": {
												"$ref": "TKTTRANSF000005"
											},
											"text": "[SEC n°7] (msg 17) 256 bits aléatoires (crypto) : impossible à deviner, même par essais répétés.",
											"fillColor": "#FFF6CC",
											"left": 1925,
											"top": 1197,
											"width": 420,
											"height": 46
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTTRANSF000408",
											"_parent": {
												"$ref": "TKTTRANSF000005"
											},
											"text": "[SEC n°9] (msg 21) Seule l'empreinte est stockée : une fuite de la base ne permet pas de rejouer un QR.  [SEC n°8] Expiration fixée par l'horloge de PostgreSQL.",
											"fillColor": "#FFF6CC",
											"left": 1925,
											"top": 1373,
											"width": 420,
											"height": 62
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTTRANSF000409",
											"_parent": {
												"$ref": "TKTTRANSF000005"
											},
											"text": "(msg 25) Un QR créé alors que l'écran est déjà fermé est annulé aussitôt : il ne sert à personne.",
											"fillColor": "#FFF6CC",
											"left": 1925,
											"top": 1619,
											"width": 420,
											"height": 46
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTTRANSF000410",
											"_parent": {
												"$ref": "TKTTRANSF000005"
											},
											"text": "[SEC n°10] (msg 27) Le QR ne contient qu'un préfixe et le jeton aléatoire : ni numéro de ticket, ni identifiant, ni donnée personnelle.  [SEC n°8] Le compte à rebours n'est qu'indicatif (calculé à partir de resteMs).",
											"fillColor": "#FFF6CC",
											"left": 1925,
											"top": 1741,
											"width": 420,
											"height": 78
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTTRANSF000411",
											"_parent": {
												"$ref": "TKTTRANSF000005"
											},
											"text": "⚠ (msg 27) Toute personne qui scanne ou photographie le QR pendant les 60 s peut l'accepter la première : le propriétaire ne choisit pas le destinataire.",
											"fillColor": "#FFDCC2",
											"left": 1925,
											"top": 1827,
											"width": 420,
											"height": 62
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTTRANSF000412",
											"_parent": {
												"$ref": "TKTTRANSF000005"
											},
											"text": "PARTIE B — Le destinataire scanne le QR et voit un aperçu",
											"fillColor": "#D6E6FF",
											"left": 1925,
											"top": 1897,
											"width": 420,
											"height": 30
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTTRANSF000413",
											"_parent": {
												"$ref": "TKTTRANSF000005"
											},
											"text": "(msg 33) Le préfixe « tiketly-transfert: » et le motif [A-Za-z0-9_-]{20,128} sont vérifiés dans l'app : un autre QR n'envoie aucune requête. La caméra s'éteint dès qu'un code est lu.",
											"fillColor": "#FFF6CC",
											"left": 1925,
											"top": 2159,
											"width": 420,
											"height": 78
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTTRANSF000414",
											"_parent": {
												"$ref": "TKTTRANSF000005"
											},
											"text": "[SEC n°9, 18] (msg 42) Recherche par empreinte, requête paramétrée.  [SEC n°10] L'aperçu ne contient ni nom ni email du propriétaire.",
											"fillColor": "#FFF6CC",
											"left": 1925,
											"top": 2769,
											"width": 420,
											"height": 62
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTTRANSF000415",
											"_parent": {
												"$ref": "TKTTRANSF000005"
											},
											"text": "[SEC n°8, 12] (msg 45) Expiration et usage unique contrôlés par le serveur dès l'aperçu.",
											"fillColor": "#FFF6CC",
											"left": 1925,
											"top": 3323,
											"width": 420,
											"height": 46
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTTRANSF000416",
											"_parent": {
												"$ref": "TKTTRANSF000005"
											},
											"text": "PARTIE C — Acceptation explicite, en une transaction  [SEC n°11, 12, 15]",
											"fillColor": "#D6E6FF",
											"left": 1925,
											"top": 3433,
											"width": 420,
											"height": 46
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTTRANSF000417",
											"_parent": {
												"$ref": "TKTTRANSF000005"
											},
											"text": "[SEC n°11] (msg 52) Rien n'est transféré sans cette confirmation : l'aperçu ne vaut pas autorisation.",
											"fillColor": "#FFF6CC",
											"left": 1925,
											"top": 3487,
											"width": 420,
											"height": 46
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTTRANSF000418",
											"_parent": {
												"$ref": "TKTTRANSF000005"
											},
											"text": "[SEC n°5] (msg 55) Le destinataire est celui du jeton Firebase, jamais un identifiant envoyé par l'app.",
											"fillColor": "#FFF6CC",
											"left": 1925,
											"top": 3619,
											"width": 420,
											"height": 46
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTTRANSF000419",
											"_parent": {
												"$ref": "TKTTRANSF000005"
											},
											"text": "[SEC n°15] (msg 58) Transfert et ticket verrouillés : une seconde acceptation simultanée attend la fin de la première, puis trouve le jeton consommé.",
											"fillColor": "#FFF6CC",
											"left": 1925,
											"top": 3805,
											"width": 420,
											"height": 62
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTTRANSF000420",
											"_parent": {
												"$ref": "TKTTRANSF000005"
											},
											"text": "[SEC n°27] (msg 61) Idempotent : le destinataire qui réessaie après une coupure obtient le même résultat, sans second transfert.",
											"fillColor": "#FFF6CC",
											"left": 1925,
											"top": 3999,
											"width": 420,
											"height": 62
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTTRANSF000421",
											"_parent": {
												"$ref": "TKTTRANSF000005"
											},
											"text": "[SEC n°12] (msg 68) Changement de propriétaire et consommation du jeton dans la même transaction : le transfert est définitif et le QR ne peut plus servir.",
											"fillColor": "#FFF6CC",
											"left": 1925,
											"top": 4507,
											"width": 420,
											"height": 62
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTTRANSF000422",
											"_parent": {
												"$ref": "TKTTRANSF000005"
											},
											"text": "[SEC n°21] Les erreurs internes (5xx) ne renvoient que « Erreur interne du serveur ».",
											"fillColor": "#FFF6CC",
											"left": 1925,
											"top": 4925,
											"width": 420,
											"height": 46
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTTRANSF000423",
											"_parent": {
												"$ref": "TKTTRANSF000005"
											},
											"text": "PARTIE D — Suivi côté propriétaire (toutes les 2 s) et fin du compte à rebours",
											"fillColor": "#D6E6FF",
											"left": 1925,
											"top": 4979,
											"width": 420,
											"height": 46
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTTRANSF000424",
											"_parent": {
												"$ref": "TKTTRANSF000005"
											},
											"text": "[SEC n°5] (msg 78) Seuls l'émetteur et le destinataire peuvent lire l'état d'un transfert : 404 pour tout autre compte.",
											"fillColor": "#FFF6CC",
											"left": 1925,
											"top": 5341,
											"width": 420,
											"height": 62
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTTRANSF000425",
											"_parent": {
												"$ref": "TKTTRANSF000005"
											},
											"text": "⚠ (msg 75) Pas de limite dédiée sur /etat et /annuler : le suivi (30 requêtes/min) consomme la limite globale de 300 / 15 min, partagée par IP (et par tous derrière Render sans trust proxy).",
											"fillColor": "#FFDCC2",
											"left": 1925,
											"top": 5411,
											"width": 420,
											"height": 78
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTTRANSF000426",
											"_parent": {
												"$ref": "TKTTRANSF000005"
											},
											"text": "[SEC n°8] (msg 84) Le serveur tranche : un transfert accepté à la dernière seconde est bien affiché comme transféré.",
											"fillColor": "#FFF6CC",
											"left": 1925,
											"top": 5707,
											"width": 420,
											"height": 46
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTTRANSF000427",
											"_parent": {
												"$ref": "TKTTRANSF000005"
											},
											"text": "PARTIE E — Annulation par le propriétaire",
											"fillColor": "#D6E6FF",
											"left": 1925,
											"top": 5761,
											"width": 420,
											"height": 30
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTTRANSF000428",
											"_parent": {
												"$ref": "TKTTRANSF000005"
											},
											"text": "[SEC n°5] (msg 92) Seul l'émetteur peut annuler, et seulement un QR encore en attente.",
											"fillColor": "#FFF6CC",
											"left": 1925,
											"top": 6241,
											"width": 420,
											"height": 46
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTTRANSF000429",
											"_parent": {
												"$ref": "TKTTRANSF000005"
											},
											"text": "PARTIE F — Anti-rejeu : réutilisation d'un ancien QR  [SEC n°12]",
											"fillColor": "#D6E6FF",
											"left": 1925,
											"top": 6477,
											"width": 420,
											"height": 46
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTTRANSF000430",
											"_parent": {
												"$ref": "TKTTRANSF000005"
											},
											"text": "[SEC n°12] (msg 101) Un jeton consommé, annulé ou expiré est refusé à chaque nouvelle tentative : un QR photographié ou partagé ne permet pas de transférer à nouveau le ticket.",
											"fillColor": "#FFF6CC",
											"left": 1925,
											"top": 6873,
											"width": 420,
											"height": 78
										}
									]
								}
							],
