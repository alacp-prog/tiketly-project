												"$ref": "TKTLOGIN000011"
											},
											"tail": {
												"$ref": "TKTLOGIN000011"
											},
											"lineStyle": 2,
											"points": "332.5:4545;362.5:4545;362.5:4565;332.5:4565",
											"showProperty": true,
											"showType": true,
											"subViews": [
												{
													"_type": "UMLActivationView",
													"_id": "TKTLOGIN000281",
													"_parent": {
														"$ref": "TKTLOGIN000280"
													},
													"model": {
														"$ref": "TKTLOGIN000279"
													},
													"left": 325.5,
													"top": 4565,
													"width": 14,
													"height": 26
												}
											],
											"activation": {
												"$ref": "TKTLOGIN000281"
											}
										},
										{
											"_type": "UMLSeqMessageView",
											"_id": "TKTLOGIN000283",
											"_parent": {
												"$ref": "TKTLOGIN000005"
											},
											"model": {
												"$ref": "TKTLOGIN000282"
											},
											"head": {
												"$ref": "TKTLOGIN000008"
											},
											"tail": {
												"$ref": "TKTLOGIN000011"
											},
											"lineStyle": 2,
											"points": "332.5:4599;127.5:4599",
											"showProperty": true,
											"showType": true,
											"subViews": []
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTLOGIN000284",
											"_parent": {
												"$ref": "TKTLOGIN000005"
											},
											"text": "LÉGENDE — [SEC n°X] : fonction de sécurité n°X du rapport (28 points).  ⚠ : point faible relevé par l'audit.  Flèche pleine : appel ; pointillés : réponse.  Le numéro de message (n) est indiqué dans chaque note.",
											"fillColor": "#F2F2F2",
											"left": 2130,
											"top": 95,
											"width": 420,
											"height": 78
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTLOGIN000285",
											"_parent": {
												"$ref": "TKTLOGIN000005"
											},
											"text": "PARTIE A — Lancement de l'app et restauration de session",
											"fillColor": "#D6E6FF",
											"left": 2130,
											"top": 181,
											"width": 420,
											"height": 30
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTLOGIN000286",
											"_parent": {
												"$ref": "TKTLOGIN000005"
											},
											"text": "(msg 4) Session Firebase persistée dans AsyncStorage, non chiffré. expo-secure-store et la biométrie ne sont pas encore intégrés.",
											"fillColor": "#FFDCC2",
											"left": 2130,
											"top": 309,
											"width": 420,
											"height": 62
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTLOGIN000287",
											"_parent": {
												"$ref": "TKTLOGIN000005"
											},
											"text": "PARTIE B — Connexion avec Google puis Firebase  [SEC n°1]",
											"fillColor": "#D6E6FF",
											"left": 2130,
											"top": 687,
											"width": 420,
											"height": 30
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTLOGIN000288",
											"_parent": {
												"$ref": "TKTLOGIN000005"
											},
											"text": "[SEC n°1] (msg 12) Client OAuth « Web » lu dans EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID (valeur publique, aucun secret dans l'app). Erreur claire si la variable manque.",
											"fillColor": "#FFF6CC",
											"left": 2130,
											"top": 829,
											"width": 420,
											"height": 62
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTLOGIN000289",
											"_parent": {
												"$ref": "TKTLOGIN000005"
											},
											"text": "[SEC n°1] (msg 19) Firebase vérifie le jeton Google côté serveur Google. Tiketly ne manipule jamais de mot de passe.",
											"fillColor": "#FFF6CC",
											"left": 2130,
											"top": 1213,
											"width": 420,
											"height": 46
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTLOGIN000290",
											"_parent": {
												"$ref": "TKTLOGIN000005"
											},
											"text": "(msg 22) La pile présentation + connexion est vidée : le bouton retour ne ramène pas à l'écran de connexion.",
											"fillColor": "#FFF6CC",
											"left": 2130,
											"top": 1355,
											"width": 420,
											"height": 46
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTLOGIN000291",
											"_parent": {
												"$ref": "TKTLOGIN000005"
											},
											"text": "(msg 25) Le détail technique reste dans la console ; l'utilisateur ne voit qu'un message simple.",
											"fillColor": "#FFF6CC",
											"left": 2130,
											"top": 1611,
											"width": 420,
											"height": 46
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTLOGIN000292",
											"_parent": {
												"$ref": "TKTLOGIN000005"
											},
											"text": "PARTIE C — Garde d'accès et récupération du profil (GET /api/users/me)  [SEC n°2, 3, 5, 6]",
											"fillColor": "#D6E6FF",
											"left": 2130,
											"top": 1665,
											"width": 420,
											"height": 46
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTLOGIN000293",
											"_parent": {
												"$ref": "TKTLOGIN000005"
											},
											"text": "[SEC n°28] (msg 28) Chaque requête de profil porte une clé uid:tentative : la réponse d'un ancien compte ou d'une ancienne requête est ignorée.",
											"fillColor": "#FFF6CC",
											"left": 2130,
											"top": 1761,
											"width": 420,
											"height": 62
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTLOGIN000294",
											"_parent": {
												"$ref": "TKTLOGIN000005"
											},
											"text": "[SEC n°2] (msg 33) Jeton Firebase joint à chaque requête. Adresse lue dans EXPO_PUBLIC_API_URL. Délai max 15 s (AbortController).",
											"fillColor": "#FFF6CC",
											"left": 2130,
											"top": 1981,
											"width": 420,
											"height": 62
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTLOGIN000295",
											"_parent": {
												"$ref": "TKTLOGIN000005"
											},
											"text": "⚠ (msg 33) api.js accepte aussi http:// : HTTPS n'est pas imposé pour un build de production.",
											"fillColor": "#FFDCC2",
											"left": 2130,
											"top": 2051,
											"width": 420,
											"height": 46
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTLOGIN000296",
											"_parent": {
												"$ref": "TKTLOGIN000005"
											},
											"text": "[SEC n°19, 20] (msg 34) En-têtes de sécurité Helmet, x-powered-by désactivé, corps JSON limité à 100 ko.  [SEC n°22] Variables d'environnement validées par Zod au démarrage du serveur.",
											"fillColor": "#FFF6CC",
											"left": 2130,
											"top": 2105,
											"width": 420,
											"height": 78
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTLOGIN000297",
											"_parent": {
												"$ref": "TKTLOGIN000005"
											},
											"text": "[SEC n°16] (msg 35) Limite de 300 requêtes / 15 min sur /api.",
											"fillColor": "#FFF6CC",
											"left": 2130,
											"top": 2191,
											"width": 420,
											"height": 46
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTLOGIN000298",
											"_parent": {
												"$ref": "TKTLOGIN000005"
											},
											"text": "⚠ (msg 35) Sans app.set(\"trust proxy\"), derrière Render, tous les clients partagent le même compteur (IP du proxy).",
											"fillColor": "#FFDCC2",
											"left": 2130,
											"top": 2245,
											"width": 420,
											"height": 46
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTLOGIN000299",
											"_parent": {
												"$ref": "TKTLOGIN000005"
											},
											"text": "[SEC n°2] (msg 38) Vérification de la signature (clés publiques Google), de l'expiration, de l'audience (FIREBASE_PROJECT_ID) et de l'émetteur.",
											"fillColor": "#FFF6CC",
											"left": 2130,
											"top": 2433,
											"width": 420,
											"height": 62
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTLOGIN000300",
											"_parent": {
												"$ref": "TKTLOGIN000005"
											},
											"text": "⚠ (msg 38) checkRevoked n'est pas activé : un compte révoqué ou désactivé garde l'accès jusqu'à l'expiration du jeton (≤ 1 h).",
											"fillColor": "#FFDCC2",
											"left": 2130,
											"top": 2503,
											"width": 420,
											"height": 62
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTLOGIN000301",
											"_parent": {
												"$ref": "TKTLOGIN000005"
											},
											"text": "[SEC n°5] (msg 40) L'identité vient uniquement du jeton vérifié (req.auth.uid), jamais d'un identifiant envoyé par l'app.",
											"fillColor": "#FFF6CC",
											"left": 2130,
											"top": 2627,
											"width": 420,
											"height": 62
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTLOGIN000302",
											"_parent": {
												"$ref": "TKTLOGIN000005"
											},
											"text": "[SEC n°18] (msg 41) Requêtes SQL paramétrées ($1, $2…) : pas d'injection SQL.  [SEC n°23] Connexion TLS vérifiée (sslmode=verify-full).",
											"fillColor": "#FFF6CC",
											"left": 2130,
											"top": 2697,
											"width": 420,
											"height": 62
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTLOGIN000303",
											"_parent": {
												"$ref": "TKTLOGIN000005"
											},
											"text": "(msg 46) Une fiche créée par l'admin n'est reprise que si email_verified = true.",
											"fillColor": "#FFF6CC",
											"left": 2130,
											"top": 3125,
											"width": 420,
											"height": 46
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTLOGIN000304",
											"_parent": {
												"$ref": "TKTLOGIN000005"
											},
											"text": "⚠ (msg 46) À restreindre aux fiches jamais utilisées si on ajoute la connexion email + mot de passe.",
											"fillColor": "#FFDCC2",
											"left": 2130,
											"top": 3179,
											"width": 420,
											"height": 46
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTLOGIN000305",
											"_parent": {
												"$ref": "TKTLOGIN000005"
											},
											"text": "[SEC n°6] (msg 49) Rôle par défaut : CITOYEN. Aucune route ne permet de modifier son propre rôle.  [SEC n°27] Création idempotente si deux requêtes arrivent en même temps.",
											"fillColor": "#FFF6CC",
											"left": 2130,
											"top": 3253,
											"width": 420,
											"height": 62
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTLOGIN000306",
											"_parent": {
												"$ref": "TKTLOGIN000005"
											},
											"text": "[SEC n°21] (msg 51) Les détails internes restent dans les logs du serveur, jamais dans la réponse.",
											"fillColor": "#FFF6CC",
											"left": 2130,
											"top": 3459,
											"width": 420,
											"height": 46
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTLOGIN000307",
											"_parent": {
												"$ref": "TKTLOGIN000005"
											},
											"text": "PARTIE D — Accès à un espace protégé après connexion (ex. /admin)  [SEC n°3, 4]",
											"fillColor": "#D6E6FF",
											"left": 2130,
											"top": 3643,
											"width": 420,
											"height": 46
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTLOGIN000308",
											"_parent": {
												"$ref": "TKTLOGIN000005"
											},
											"text": "[SEC n°3, 4] (msg 56) Garde côté app : sinon <Redirect /accueil>. Ce n'est qu'un confort d'affichage : le backend fait foi.",
											"fillColor": "#FFF6CC",
											"left": 2130,
											"top": 3741,
											"width": 420,
											"height": 62
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTLOGIN000309",
											"_parent": {
												"$ref": "TKTLOGIN000005"
											},
											"text": "[SEC n°3, 4] (msg 61) Le rôle est relu en base à chaque requête : un changement de rôle s'applique immédiatement.  [SEC n°17] Paramètres validés par Zod (role, page, limit).",
											"fillColor": "#FFF6CC",
											"left": 2130,
											"top": 4005,
											"width": 420,
											"height": 62
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTLOGIN000310",
											"_parent": {
												"$ref": "TKTLOGIN000005"
											},
											"text": "PARTIE E — Déconnexion",
											"fillColor": "#D6E6FF",
											"left": 2130,
											"top": 4241,
											"width": 420,
											"height": 30
										},
										{
											"_type": "UMLNoteView",
											"_id": "TKTLOGIN000311",
											"_parent": {
												"$ref": "TKTLOGIN000005"
											},
											"text": "(msg 68) La session Firebase est fermée même si la déconnexion Google échoue. Le compte Google est oublié : le sélecteur réapparaît à la prochaine connexion.",
											"fillColor": "#FFF6CC",
											"left": 2130,
											"top": 4417,
											"width": 420,
											"height": 62
										}
									]
								}
							],
							"messages": [
								{
