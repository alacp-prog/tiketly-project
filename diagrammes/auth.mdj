											"showProperty": true,
											"showType": true,
											"subViews": []
										},
										{
											"_type": "UMLSeqMessageView",
											"_id": "TKTLOGIN000280",
											"_parent": {
												"$ref": "TKTLOGIN000005"
											},
											"model": {
